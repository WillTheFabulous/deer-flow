{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P13 画面完整描述 result",
  "type": "object",
  "required": ["summary", "style", "palette", "subjects", "environment", "change_units", "composition", "mood", "harmony_rules", "prompt_en"],
  "properties": {
    "summary": {"type": "string", "minLength": 1, "description": "一两句话的总述"},
    "style": {
      "type": "object",
      "required": ["genre", "linework", "coloring", "lighting", "texture_detail", "shape_language", "saturation_contrast"],
      "properties": {
        "genre": {"type": "string", "minLength": 1, "description": "画风定位"},
        "linework": {"type": "string", "minLength": 1, "description": "轮廓与线条"},
        "coloring": {"type": "string", "minLength": 1, "description": "上色方式"},
        "lighting": {"type": "string", "minLength": 1, "description": "光影做法"},
        "texture_detail": {"type": "string", "minLength": 1, "description": "质感与细节密度"},
        "shape_language": {"type": "string", "minLength": 1, "description": "造型语言"},
        "saturation_contrast": {"type": "string", "minLength": 1, "description": "饱和度、明度与对比"}
      }
    },
    "palette": {
      "type": "object",
      "required": ["background", "subjects", "accents", "relationships"],
      "properties": {
        "background": {"type": "string"},
        "subjects": {"type": "string"},
        "accents": {"type": "string"},
        "relationships": {"type": "string", "description": "冷暖关系与面积关系"}
      }
    },
    "subjects": {
      "type": "array",
      "description": "拆解里 role 为 subject 的对象每个一条",
      "items": {
        "type": "object",
        "required": ["object_id", "name", "appearance", "colors", "face_expression", "pose_action", "position_scale", "en"],
        "properties": {
          "object_id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "appearance": {"type": "string"},
          "colors": {"type": "string"},
          "face_expression": {"type": "string"},
          "pose_action": {"type": "string"},
          "position_scale": {"type": "string"},
          "en": {"type": "string", "minLength": 10, "description": "这个主体的英文描述，单独放进提示词也能画对"}
        }
      }
    },
    "environment": {
      "type": "array",
      "description": "其余对象按画面层次分条，同类可以合并",
      "items": {
        "type": "object",
        "required": ["object_ids", "name", "appearance", "rendering", "en"],
        "properties": {
          "object_ids": {"type": "array", "items": {"type": "string"}},
          "name": {"type": "string", "minLength": 1},
          "appearance": {"type": "string"},
          "rendering": {"type": "string", "description": "用什么画法画的，和主体是不是同一套画法"},
          "en": {"type": "string", "minLength": 5}
        }
      }
    },
    "change_units": {
      "type": "array",
      "description": "可变单元清单：会一起改的一组对象算一个单元（单个角色、满屏星星、一圈花边……）；多个角色时既有组单元也有显眼的成员单元",
      "items": {
        "type": "object",
        "required": ["unit_id", "name", "kind", "object_ids", "salience", "en"],
        "properties": {
          "unit_id": {"type": "string", "pattern": "^U[0-9]{2,3}$"},
          "name": {"type": "string", "minLength": 1, "maxLength": 8, "description": "给人看的短名，如「高地牛」「满屏星星」「全部恐龙」"},
          "kind": {"enum": ["character", "object", "decoration", "prop", "text"]},
          "object_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "parent": {"type": ["string", "null"], "description": "成员单元写它所属组单元的 unit_id，其余为 null"},
          "salience": {"enum": ["large", "medium", "small"]},
          "not_applicable": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field_id", "reason"],
              "properties": {"field_id": {"type": "string"}, "reason": {"type": "string", "minLength": 2}}
            },
            "description": "在这个单元上不成立的字段与原因（如背影看不到五官）"
          },
          "en": {"type": "string", "minLength": 3, "description": "点名这个单元的英文短语，如 the shaggy highland cow in the center"}
        }
      }
    },
    "composition": {"type": "string", "minLength": 1},
    "mood": {"type": "string"},
    "text_elements": {"type": ["string", "null"], "description": "印花里的文字（照抄原文并写位置），没有为 null"},
    "harmony_rules": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {"type": "string", "minLength": 4},
      "description": "换场景、换背景、加元素时新内容必须照着画的画风统一规则"
    },
    "corrections": {"type": "array", "items": {"type": "string"}, "description": "看图发现拆解写错的地方"},
    "prompt_en": {
      "type": "object",
      "required": ["style_anchor", "full_scene"],
      "properties": {
        "style_anchor": {"type": "string", "minLength": 20, "description": "1–3 句英文画风与配色语言"},
        "full_scene": {"type": "string", "minLength": 80, "description": "120–300 个英文单词的完整画面描述"}
      }
    }
  }
}
